{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "CaseGuard Case API",
    "description" : "The only door into CRM data. Every call needs X-Tenant-Id and X-Customer-Id (from the trusted session). Errors are RFC 9457 ProblemDetail with a stable `code`.",
    "version" : "0.2.0"
  },
  "paths" : {
    "/supervisor/approvals/{approvalId}/decision" : {
      "post" : {
        "tags" : [ "approval-controller" ],
        "summary" : "Approve or reject (once only)",
        "operationId" : "decide",
        "parameters" : [ {
          "name" : "approvalId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "X-Tenant-Id",
          "in" : "header",
          "description" : "Tenant (company) id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "X-Supervisor-Id",
          "in" : "header",
          "description" : "Supervisor id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DecisionRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Decision recorded",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApprovalDto"
                }
              }
            }
          },
          "404" : {
            "description" : "not_found (or another tenant's approval)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409" : {
            "description" : "already_decided | approval_expired",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/cases/{caseId}/escalations" : {
      "post" : {
        "tags" : [ "escalation-controller" ],
        "summary" : "Request an escalation (idempotent by Idempotency-Key)",
        "operationId" : "request",
        "parameters" : [ {
          "name" : "caseId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "Idempotency-Key",
          "in" : "header",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "X-Tenant-Id",
          "in" : "header",
          "description" : "Tenant (company) id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "X-Customer-Id",
          "in" : "header",
          "description" : "Customer id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/EscalationRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "New escalation accepted; worker completes it asynchronously",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EscalationDto"
                }
              }
            }
          },
          "200" : {
            "description" : "Replay: this operation already created this escalation",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EscalationDto"
                }
              }
            }
          },
          "400" : {
            "description" : "missing_identity | missing_idempotency_key | invalid_request",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403" : {
            "description" : "approval_required (has `why`): order over the limit without a matching APPROVED approval",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404" : {
            "description" : "not_found (missing or not the caller's case)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409" : {
            "description" : "already_open (has existingEscalationId) | case_not_open | operation_conflict",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/cases/{caseId}/approvals" : {
      "post" : {
        "tags" : [ "approval-controller" ],
        "summary" : "Ask a supervisor to approve an escalation (idempotent by Idempotency-Key = operation id)",
        "operationId" : "request_1",
        "parameters" : [ {
          "name" : "caseId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "Idempotency-Key",
          "in" : "header",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "X-Tenant-Id",
          "in" : "header",
          "description" : "Tenant (company) id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "X-Customer-Id",
          "in" : "header",
          "description" : "Customer id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ApprovalRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Approval requested, status PENDING",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApprovalDto"
                }
              }
            }
          },
          "200" : {
            "description" : "Replay: this operation already asked",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApprovalDto"
                }
              }
            }
          },
          "404" : {
            "description" : "not_found",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409" : {
            "description" : "case_changed | operation_conflict",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/supervisor/approvals" : {
      "get" : {
        "tags" : [ "approval-controller" ],
        "summary" : "Pending approvals of the supervisor's tenant, oldest first",
        "operationId" : "pending",
        "parameters" : [ {
          "name" : "X-Tenant-Id",
          "in" : "header",
          "description" : "Tenant (company) id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "X-Supervisor-Id",
          "in" : "header",
          "description" : "Supervisor id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ApprovalDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/orders" : {
      "get" : {
        "tags" : [ "order-controller" ],
        "operationId" : "listOrders",
        "parameters" : [ {
          "name" : "X-Tenant-Id",
          "in" : "header",
          "description" : "Tenant (company) id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "X-Customer-Id",
          "in" : "header",
          "description" : "Customer id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/OrderDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/orders/{orderId}" : {
      "get" : {
        "tags" : [ "order-controller" ],
        "operationId" : "getOrder",
        "parameters" : [ {
          "name" : "orderId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "X-Tenant-Id",
          "in" : "header",
          "description" : "Tenant (company) id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "X-Customer-Id",
          "in" : "header",
          "description" : "Customer id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OrderDto"
                }
              }
            }
          }
        }
      }
    },
    "/escalations" : {
      "get" : {
        "tags" : [ "escalation-controller" ],
        "summary" : "Find the escalation an operation created (reconcile step); empty list = not created",
        "operationId" : "findByOperation",
        "parameters" : [ {
          "name" : "operationId",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "X-Tenant-Id",
          "in" : "header",
          "description" : "Tenant (company) id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "X-Customer-Id",
          "in" : "header",
          "description" : "Customer id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/EscalationDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/escalations/{escalationId}" : {
      "get" : {
        "tags" : [ "escalation-controller" ],
        "summary" : "Get one escalation (verify step)",
        "operationId" : "get",
        "parameters" : [ {
          "name" : "escalationId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "X-Tenant-Id",
          "in" : "header",
          "description" : "Tenant (company) id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "X-Customer-Id",
          "in" : "header",
          "description" : "Customer id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The caller's escalation",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EscalationDto"
                }
              }
            }
          },
          "404" : {
            "description" : "not_found",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/cases" : {
      "get" : {
        "tags" : [ "case-controller" ],
        "operationId" : "findByOrder",
        "parameters" : [ {
          "name" : "orderId",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "X-Tenant-Id",
          "in" : "header",
          "description" : "Tenant (company) id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "X-Customer-Id",
          "in" : "header",
          "description" : "Customer id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/CaseDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cases/{caseId}" : {
      "get" : {
        "tags" : [ "case-controller" ],
        "operationId" : "getCase",
        "parameters" : [ {
          "name" : "caseId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "X-Tenant-Id",
          "in" : "header",
          "description" : "Tenant (company) id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "X-Customer-Id",
          "in" : "header",
          "description" : "Customer id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CaseDto"
                }
              }
            }
          }
        }
      }
    },
    "/approvals/{approvalId}" : {
      "get" : {
        "tags" : [ "approval-controller" ],
        "summary" : "Get one of the caller's approvals",
        "operationId" : "get_1",
        "parameters" : [ {
          "name" : "approvalId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "X-Tenant-Id",
          "in" : "header",
          "description" : "Tenant (company) id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "X-Customer-Id",
          "in" : "header",
          "description" : "Customer id from the trusted session",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApprovalDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "DecisionRequest" : {
        "type" : "object",
        "properties" : {
          "decision" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "APPROVED|REJECTED"
          }
        },
        "required" : [ "decision" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "type" : {
            "type" : "string",
            "format" : "uri"
          },
          "title" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : { }
          }
        }
      },
      "ApprovalDto" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "caseId" : {
            "type" : "string"
          },
          "operationId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "caseVersion" : {
            "type" : "integer",
            "format" : "int32"
          },
          "policyRef" : {
            "type" : "string"
          },
          "reason" : {
            "type" : "string"
          },
          "conversationRef" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          },
          "decidedBy" : {
            "type" : "string"
          },
          "decidedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "expiresAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "EscalationRequest" : {
        "type" : "object",
        "properties" : {
          "reason" : {
            "type" : "string",
            "maxLength" : 1000,
            "minLength" : 0
          },
          "policyRef" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "^[A-Z]+-\\d+@v\\d+$"
          },
          "approvalId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "policyRef", "reason" ]
      },
      "EscalationDto" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "caseId" : {
            "type" : "string"
          },
          "operationId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "status" : {
            "type" : "string"
          },
          "reason" : {
            "type" : "string"
          },
          "policyRef" : {
            "type" : "string"
          },
          "requestedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "completedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "ApprovalRequest" : {
        "type" : "object",
        "properties" : {
          "caseVersion" : {
            "type" : "integer",
            "format" : "int32"
          },
          "policyRef" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "^[A-Z]+-\\d+@v\\d+$"
          },
          "reason" : {
            "type" : "string",
            "maxLength" : 1000,
            "minLength" : 0
          },
          "conversationRef" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          }
        },
        "required" : [ "caseVersion", "policyRef", "reason" ]
      },
      "OrderDto" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "customerId" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "amountCents" : {
            "type" : "integer",
            "format" : "int64"
          },
          "status" : {
            "type" : "string"
          },
          "promisedDate" : {
            "type" : "string",
            "format" : "date"
          },
          "deliveredAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "CaseDto" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "orderId" : {
            "type" : "string"
          },
          "subject" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          },
          "version" : {
            "type" : "integer",
            "format" : "int32"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      }
    }
  }
}
